from decimal import Decimal
from typing import ClassVar
from pydantic_settings import BaseSettings
from sqlalchemy.ext.declarative import declarative_base

DBBaseModel = declarative_base()

class Settings(BaseSettings):
    API_V1_STR: str = "/api/v1"
    DB_URL: str = "postgresql+asyncpg://seu_usuario:senha@localhost:5432/norven"
    DBBaseModel: ClassVar[type] = DBBaseModel

    JWT_SECRET: str = "seu_jwt_secret_aqui"
    """
    import secrets
    token: str = secrets.token_urlsafe(32)
    """
    ALGORITHM: str = "HS256"

    # 60 minutos * 24 horas * 7 dias = 1 semana
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 60 * 24 * 7

    PRIMARY_ADMIN_PASSWORD: str

    PRODUTO_VALIDADE_ALERTA_DIAS: int = 30
    ESTOQUE_BAIXO_LIMITE: Decimal = Decimal("10")

    class Config:
        case_sensitive = True
    
settings: Settings = Settings()