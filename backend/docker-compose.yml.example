services:
  postgres:
    image: postgres:16-alpine
    container_name: norven-postgres
    
    environment:
      POSTGRES_USER: username_here
      POSTGRES_PASSWORD: password_here
      POSTGRES_DB: database_name_here

    ports:
      - "5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U username_here -d database_name_here"]
      interval: 5s
      timeout: 5s
      retries: 5
    
    restart: unless-stopped

volumes:
  postgres_data: